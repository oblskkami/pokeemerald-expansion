$(HOST_LINK_SHIM_OBJ): $(HOST_LINK_SHIM)
	@mkdir -p $(dir $@)
	@rm -f $@.tmp
	$(HOST_CC) $(HOST_CPPFLAGS) $(HOST_CFLAGS) -c $< -o $@.tmp
	@test -s $@.tmp
	@mv -f $@.tmp $@

# Merge the data/*.s objects on their own first: those are the only units that
# pick up duplicated absolute symbols from C enum bodies leaking through the
# headers, so the tolerance is scoped to them and duplicate function symbols
# coming from the C sources are still reported below.
$(HOST_LINK_DATA_OBJ): host-data
	@mkdir -p $(dir $@)
	@rm -f $@.tmp
	$(HOST_LD) $(HOST_REL_LDFLAGS) $(HOST_LD_DEDUP) -o $@.tmp $(HOST_DATA_OBJS)
	@test -s $@.tmp
	@mv -f $@.tmp $@

$(HOST_LINK_AUDIT_OBJ): host-objects host-songs $(HOST_LINK_DATA_OBJ) $(HOST_LINK_SHIM_OBJ)
	@mkdir -p $(dir $@)
	@rm -f $@.tmp
	$(HOST_LD) $(HOST_REL_LDFLAGS) -o $@.tmp $(HOST_OBJECTS) $(HOST_LINK_DATA_OBJ) $(HOST_SONG_OBJS) $(HOST_LINK_SHIM_OBJ)
	@test -s $@.tmp
	@mv -f $@.tmp $@

$(HOST_SCRIPT_LINK_OBJ): $(HOST_LINK_AUDIT_OBJ)
	@mkdir -p $(dir $@)
	@rm -f $@.tmp
	$(HOST_OBJCOPY) --redefine-sym $(HOST_MAIN_SYMBOL)=host_platform_main $< $@.tmp
	@test -s $@.tmp
	@mv -f $@.tmp $@

